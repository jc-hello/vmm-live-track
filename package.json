{
  "name": "vmm-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Live map, analytics and alerts for trail races timed by raceresult.com, on Cloudflare Workers + D1.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "build-route": "tsx --env-file-if-exists=.env scripts/build-route.ts",
    "backfill": "tsx --env-file-if-exists=.env scripts/backfill.ts",
    "local-logger": "tsx --env-file-if-exists=.env scripts/local-logger.ts"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "mapbox-gl": "^3.31.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
