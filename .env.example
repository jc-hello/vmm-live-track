# Copy to .env (git-ignored).

# Which race to build and run: a folder under races/
RACE=vmm-2026

# Mapbox public access token (pk.*) for the map page. Get one at https://account.mapbox.com/
# Restrict it to your site's URL in the Mapbox dashboard: it ends up in the built JavaScript.
VITE_MAPBOX_TOKEN=
